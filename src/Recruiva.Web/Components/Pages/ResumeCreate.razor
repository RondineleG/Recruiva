@page "/resumes/new"
@rendermode InteractiveServer
@using Recruiva.Core.DTOs.Request
@using Recruiva.Core.Enums
@using Recruiva.Core.UseCases.Resumes
@using Recruiva.Web.Services
@inject CreateResumeUseCase CreateResumeUseCase
@inject ICurrentUserHelper CurrentUserHelper

<PageTitle>Criar Currículo - Recruiva</PageTitle>

<div class="container mt-4 page-form-shell resume-create-page">
    <header class="page-heading">
        <div class="page-heading__copy">
            <span class="page-kicker">MINHA CARREIRA</span>
            <h1>Criar currículo</h1>
            <p>Comece com um resumo claro. Você pode completar as outras seções depois.</p>
        </div>
        <button class="btn btn-secondary" @onclick="Cancel">Cancelar</button>
    </header>
    <div class="row">
        <div class="col-lg-8 mx-auto">

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle"></i> @errorMessage
                </div>
            }

            @if (successMessage)
            {
                <div class="alert alert-success">
                    <i class="bi bi-check-circle"></i> Currículo criado com sucesso!
                    <br />
                    <button class="btn btn-primary mt-2" @onclick="ViewResumes">
                        Ver Meus Currículos
                    </button>
                </div>
            }
            else
            {
                <div class="card page-form-card">
                    <div class="card-body">
                        <EditForm Model="model" OnValidSubmit="SubmitForm">
                            <DataAnnotationsValidator />

                            <!-- Informações Básicas -->
                            <h5 class="mb-3"><i class="bi bi-info-circle"></i> Informações Básicas</h5>
                            
                            <div class="mb-3">
                                <label class="form-label" for="model.Title">Título do Currículo *</label>
                                <InputText class="form-control" @bind-Value="model.Title" id="model.Title"
                                    placeholder="Ex: Desenvolvedor Full Stack Pleno" />
                                <div class="form-text">Um título claro ajuda os recrutadores a entenderem seu perfil</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="model.Summary">Resumo Profissional</label>
                                <InputTextArea class="form-control" @bind-Value="model.Summary" id="model.Summary" rows="4"
                                    placeholder="Escreva um breve resumo sobre sua experiência e objetivos profissionais..." />
                                <div class="form-text">Máximo 2000 caracteres</div>
                            </div>

                            <div class="mb-3 form-check">
                                <InputCheckbox class="form-check-input" @bind-Value="model.IsActive" id="model.IsActive" />
                                <label class="form-check-label" for="model.IsActive">
                                    <strong>Definir como currículo ativo</strong>
                                    <br />
                                    <small class="text-muted">Este currículo será usado automaticamente nas candidaturas</small>
                                </label>
                            </div>

                            <hr class="my-4" />

                            <!-- Próximas Seções -->
                            <div class="alert alert-info">
                                <h5><i class="bi bi-info-circle"></i> Você poderá complementar depois</h5>
                                <p class="mb-2">Após criar o currículo básico, você poderá adicionar:</p>
                                <ul class="mb-0">
                                    <li><strong>Formação acadêmica</strong> — sua educação e cursos</li>
                                    <li><strong>Experiência profissional</strong> — trabalhos anteriores</li>
                                    <li><strong>Idiomas</strong> — línguas que você domina</li>
                                    <li><strong>Habilidades</strong> — suas competências técnicas</li>
                                </ul>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-success btn-lg" disabled="@isSubmitting" data-testid="resume-create-submit">
                                    @if (isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    }
                                    <i class="bi bi-check-circle"></i> Criar Currículo
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private CreateResumeRequest model = new()
    {
        IsActive = true
    };
    private string errorMessage = string.Empty;
    private bool successMessage = false;
    private bool isSubmitting = false;

    protected override void OnInitialized()
    {
        // Obter CandidateId do usuário logado
        var candidateId = CurrentUserHelper.GetCandidateId();
        if (candidateId.HasValue)
        {
            model.CandidateId = candidateId.Value;
        }
    }

    private async Task SubmitForm()
    {
        isSubmitting = true;
        errorMessage = string.Empty;

        var result = await CreateResumeUseCase.ExecuteAsync(model);

        if (result.Status == EResultStatus.Success)
        {
            successMessage = true;
        }
        else
        {
            errorMessage = result.Message;
        }

        isSubmitting = false;
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/resumes");
    }

    private void ViewResumes()
    {
        Navigation.NavigateTo("/resumes");
    }

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;
}
