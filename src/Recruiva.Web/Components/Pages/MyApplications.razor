@page "/my-applications"
@rendermode InteractiveServer

<PageTitle>Minhas candidaturas - Recruiva</PageTitle>

<div class="container my-applications-page">
    <header class="page-heading">
        <div class="page-heading__copy">
            <span class="page-kicker">MINHA CARREIRA</span>
            <h1>Minhas candidaturas</h1>
            <p>Acompanhe as oportunidades para as quais você já se candidatou.</p>
        </div>
    </header>

    <section class="empty-state" aria-labelledby="applications-empty-title">
        <span class="empty-state__icon" aria-hidden="true">↗</span>
        <span class="page-kicker">SUA PRÓXIMA OPORTUNIDADE</span>
        <h2 id="applications-empty-title">Sua jornada começa com uma candidatura</h2>
        <p>Quando você se candidatar, poderá acompanhar aqui as atualizações de cada processo seletivo.</p>
        <a href="/jobs" class="btn btn-primary">Explorar vagas <span aria-hidden="true">↗</span></a>
    </section>
</div>
